# Geradas automaticamente pelo script docker/setup.ps1.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-long-random-app-password
POSTGRES_PASSWORD=replace-with-a-long-random-password
AUTHENTICATION_API_KEY=replace-with-a-long-random-api-key

# Publicação local. Em VPS, use um proxy reverso com HTTPS.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8081
APP_BASE_URL=
